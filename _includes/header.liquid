<header>
  {% comment %} ============================================================
     SINGLE nav for the whole site. Every page (home, sections, and
     every blog post) renders this same top bar. No per-page nav, no
     custom_topbar branching. mix-blend-mode makes the text auto-invert
     so it stays readable on both dark and light page backgrounds.
  ============================================================ {% endcomment %}
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,340,500;9..144,600&family=Inter:wght@400;500;600&display=swap');

    /* Always reserve the scrollbar space so the fixed nav (and page content)
       never shift left/right between long pages and short pages. */
    html { overflow-y: scroll; scrollbar-gutter: stable; }

    .custom-topbar {
      position: fixed; top: 0; left: 0; right: 0; z-index: 1030;
      display: flex; justify-content: space-between; align-items: center;
      padding: 26px 5vw 28px;
      mix-blend-mode: difference;
      font-family: 'Inter', sans-serif;
      pointer-events: none;            /* let clicks pass except on links */
    }
    .custom-topbar .logo,
    .custom-topbar .topnav a { pointer-events: auto; }

    .custom-topbar .logo { font-family: 'Fraunces', serif; font-size: 15px; letter-spacing: .02em; color: #eef2f0; }
    .custom-topbar .logo b { font-weight: 600; }

    .custom-topbar .topnav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 22px; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; }
    .custom-topbar .topnav a { text-decoration: none; color: #eef2f0; opacity: .8; }
    .custom-topbar .topnav a:hover,
    .custom-topbar .topnav a.active { opacity: 1; }

    /* push page content below the fixed bar on EVERY page */
    .container.mt-5 { padding-top: 70px; }

    /* mobile: stack logo over links (nav stays visible, no hidden menu) */
    @media (max-width: 700px) {
      .custom-topbar { flex-direction: column; align-items: flex-start; gap: 12px; padding: 22px 6vw 16px; }
      .custom-topbar .topnav { justify-content: flex-start; gap: 14px; }
      .container.mt-5 { padding-top: 132px; }
    }
  </style>

  <div class="custom-topbar">
    <div class="logo"><b>{{ site.first_name | default: site.title }}</b> {{ site.last_name }}</div>
    <nav class="topnav">
      <a href="{{ '/' | relative_url }}"                {% if page.permalink == '/' %}class="active"{% endif %}>About</a>
      <a href="{{ '/art/' | relative_url }}"            {% if page.url contains '/art/' %}class="active"{% endif %}>Art</a>
      <a href="{{ '/engine/' | relative_url }}"         {% if page.url contains '/engine/' %}class="active"{% endif %}>Engine</a>
      <a href="{{ '/story-creating/' | relative_url }}" {% if page.url contains '/story-creating/' %}class="active"{% endif %}>Story-Creating</a>
      <a href="{{ '/research/' | relative_url }}"       {% if page.url contains '/research/' %}class="active"{% endif %}>Research</a>
      <a href="{{ '/cv/' | relative_url }}"             {% if page.url contains '/cv/' %}class="active"{% endif %}>CV</a>
    </nav>
  </div>

  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>