<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js"></script>
<script>
  gsap.registerPlugin(ScrollTrigger);

  /* ---- 부드러운 스크롤 (Lenis + GSAP) ---- */
  var lenis = null;
  if (window.Lenis) {
    lenis = new Lenis({
      duration: 1.15,
      easing: function(t){ return Math.min(1, 1.001 - Math.pow(2, -10 * t)); },
      smoothWheel: true,
      wheelMultiplier: 0.9
    });
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add(function(time){ lenis.raf(time * 1000); });
    gsap.ticker.lagSmoothing(0);
  }

  /* 앵커(#) 클릭을 부드럽게 */
  document.querySelectorAll('a[href^="#"]').forEach(function(a){
    a.addEventListener('click', function(e){
      var target = document.querySelector(a.getAttribute('href'));
      if(!target) return;
      e.preventDefault();
      if(lenis){ lenis.scrollTo(target, { offset: -24, duration: 1.2 }); }
      else { target.scrollIntoView({ behavior:'smooth' }); }
    });
  });

  /* 히어로 행성 회전 + 노드 */
  gsap.to('.world', { rotateZ: 360, duration: 40, repeat: -1, ease: 'none' });
  var nodes = ['12%,18%','80%,10%','65%,82%','8%,70%','92%,55%'];
  nodes.forEach(function(pos){
    var parts = pos.split(',');
    var n = document.createElement('div');
    n.className = 'node';
    n.style.left = parts[0]; n.style.top = parts[1];
    document.querySelector('.world').appendChild(n);
  });

  /* 프로젝트 섹션 등장 애니메이션 */
  gsap.utils.toArray('.proj').forEach(function(sec){
    gsap.from(sec.querySelectorAll('.proj-head, .frame, .tools, h2, .lead, .chip-group'), {
      y: 20, opacity: 0, duration: .7, stagger: .06, ease: 'power2.out',
      scrollTrigger: { trigger: sec, start: 'top 78%' }
    });
  });

  /* 오른쪽 점 네비 활성화 */
  var ids = ['hero','project-1','project-2','project-3'];
  ids.forEach(function(id){
    ScrollTrigger.create({
      trigger: '#' + id, start: 'top center', end: 'bottom center',
      onToggle: function(self){
        if(!self.isActive) return;
        document.querySelectorAll('.rail a').forEach(function(a){ a.classList.remove('active'); });
        var link = document.querySelector('.rail a[href="#' + id + '"]');
        if(link) link.classList.add('active');
      }
    });
  });
</script>
</body>
</html>
