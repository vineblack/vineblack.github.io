---
# 다른 레이아웃에 감싸이지 않는 독립 레이아웃입니다.
# al-folio 기본 헤더/네비 대신 아래 디자인이 페이지 전체를 차지합니다.
---
<!DOCTYPE html>
<html lang="{{ site.lang | default: 'ko' }}">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ page.title | default: site.title }}</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,340,500;9..144,600&family=Inter:wght@400;500;600&display=swap');

  :root{
    --bg:#0b0f14;
    --line:rgba(238,242,240,.1);
    --ink:#eef2f0;
    --ink-dim:rgba(238,242,240,.55);
    --ink-faint:rgba(238,242,240,.32);
    --amber:#e8b34f;
    --cyan:#7fd8d0;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  html,body{background:var(--bg);color:var(--ink);font-family:'Inter',sans-serif;overflow-x:hidden;}
  
  /* Lenis 부드러운 스크롤 */
  html.lenis,html.lenis body{height:auto;}
  .lenis.lenis-smooth{scroll-behavior:auto !important;}
  .lenis.lenis-smooth [data-lenis-prevent]{overscroll-behavior:contain;}
  .lenis.lenis-stopped{overflow:hidden;}
  a{color:inherit;}

  /* ---- chrome ---- */
  .topbar{position:fixed;top:0;left:0;right:0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:44px 6vw 26px;mix-blend-mode:difference;}
  .logo{font-family:'Fraunces',serif;font-size:15px;letter-spacing:.02em;}
  .logo b{font-weight:600;}
  .topnav{display:flex;gap:22px;font-size:12px;letter-spacing:.12em;text-transform:uppercase;}
  .topnav a{text-decoration:none;color:var(--ink);opacity:.8;}
  .topnav a:hover{opacity:1;}

  .rail{position:fixed;right:5vw;top:50%;transform:translateY(-50%);z-index:20;display:flex;flex-direction:column;gap:22px;}
  .rail a{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-dim);text-decoration:none;display:flex;align-items:center;gap:10px;transition:color .25s;}
  .rail a .dot{width:5px;height:5px;border-radius:50%;background:var(--ink-dim);transition:background .25s,box-shadow .25s;}
  .rail a.active,.rail a:hover{color:var(--amber);}
  .rail a.active .dot,.rail a:hover .dot{background:var(--amber);box-shadow:0 0 8px var(--amber);}

  /* ---- hero (행성 위치 수정: top 38%) ---- */
  .hero{min-height:100vh;position:relative;display:flex;flex-direction:column;justify-content:center;padding:0 5vw;background:
      radial-gradient(ellipse at 70% 40%, rgba(127,216,208,.08), transparent 55%),
      radial-gradient(ellipse at 20% 70%, rgba(232,179,79,.06), transparent 50%);}
  .eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--cyan);margin-bottom:18px;display:flex;align-items:center;gap:10px;}
  .eyebrow::before{content:"";width:26px;height:1px;background:var(--cyan);}
  .giant{font-family:'Fraunces',serif;font-weight:340;font-size:clamp(64px,13vw,180px);line-height:.86;letter-spacing:-0.01em;}
  .giant .accent{font-weight:600;color:transparent;-webkit-text-stroke:1px var(--ink);}
  .hero-sub{margin-top:26px;max-width:420px;color:var(--ink-dim);font-size:15px;line-height:1.75;}

  /* 1번 수정사항: 행성이 하단에 잘리지 않도록 위로 이동 (52% -> 38%) */
  .world{position:absolute;right:5vw;top:38%;transform:translateY(-50%);width:clamp(380px,44vw,640px);height:clamp(380px,44vw,640px);perspective:1200px;}
  .world .glow{position:absolute;left:50%;top:50%;width:60%;height:60%;transform:translate(-50%,-50%);border-radius:50%;
    background:radial-gradient(circle,rgba(127,216,208,.28),rgba(127,216,208,.06) 45%,transparent 70%);filter:blur(6px);pointer-events:none;}
  .world .ring{position:absolute;inset:0;border:1px solid rgba(127,216,208,.42);border-radius:50%;transform-style:preserve-3d;}
  .world .ring.r1{transform:rotateX(70deg) rotateZ(0deg);}
  .world .ring.r2{transform:rotateX(70deg) rotateZ(60deg);border-color:rgba(232,179,79,.38);}
  .world .ring.r3{transform:rotateX(70deg) rotateZ(120deg);}
  .world .core{position:absolute;left:50%;top:50%;width:20%;height:20%;transform:translate(-50%,-50%);border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #fff, var(--cyan) 48%, transparent 78%);filter:blur(.3px);
    box-shadow:0 0 40px rgba(127,216,208,.5),0 0 90px rgba(127,216,208,.25);}
  .world .node{position:absolute;width:7px;height:7px;border-radius:50%;background:var(--amber);box-shadow:0 0 12px var(--amber);}

  .scroll-tag{position:absolute;bottom:34px;left:5vw;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-dim);}

  /* ================================================================
     PROJECT SECTIONS
     ================================================================ */
  main{padding:0;max-width:none;margin:0;}

  .proj{min-height:100vh;display:flex;flex-direction:column;justify-content:center;padding:14vh 6vw;border-top:1px solid var(--line);}

  .proj-head{display:flex;align-items:center;justify-content:space-between;
    font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink);
    padding-bottom:22px;border-bottom:1px solid var(--line);margin-bottom:7vh;}
  .proj-head .idx{color:var(--amber);}
  .proj-head .k{color:var(--ink-faint);}

  .proj-grid{display:grid;grid-template-columns:0.9fr 1.1fr;gap:6vw;align-items:center;}
  .proj.flip .proj-visual{order:2;}
  .proj.flip .proj-copy{order:1;}

  /* 2번 수정사항: 이미지를 비워두고 회색 배경 + 이미지 글자만 표시 */
  .frame{position:relative;aspect-ratio:1/1;border-radius:16px;overflow:hidden;
    border:1px solid var(--line);background:#2a323d;
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 40px 90px rgba(0,0,0,.55);}
  .frame-text{font-size:16px;letter-spacing:.12em;color:var(--ink-dim);font-weight:500;text-transform:uppercase;}
  .frame .halo{position:absolute;left:50%;bottom:12%;width:70%;height:38%;transform:translateX(-50%);
    background:radial-gradient(ellipse at center,rgba(232,179,79,.35),transparent 70%);filter:blur(18px);pointer-events:none;}

  .tools{margin-top:34px;}
  .tools h4{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink);margin-bottom:16px;}
  .tools .cols{display:flex;gap:64px;flex-wrap:wrap;}
  .tools ul{list-style:none;}
  .tools li{font-size:13px;color:var(--ink-dim);line-height:2.1;}

  .proj-copy h2{font-family:'Fraunces',serif;font-weight:340;line-height:.92;
    font-size:clamp(40px,5.4vw,86px);letter-spacing:-0.01em;}
  .proj-copy .lead{margin-top:26px;max-width:540px;font-size:15px;line-height:1.85;color:var(--ink-dim);}

  .chip-group{margin-top:40px;}
  .chip-group .label{font-family:'Fraunces',serif;font-size:19px;color:var(--ink);margin-bottom:16px;}
  .chips{display:flex;flex-wrap:wrap;gap:10px;}
  .chip{padding:9px 18px;border:1px solid var(--line);border-radius:999px;
    font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-dim);
    transition:border-color .25s,color .25s;}
  .chip:hover{border-color:var(--amber);color:var(--ink);}
  .chip.solid{background:var(--ink);border-color:var(--ink);color:var(--bg);font-weight:500;}
  .ph{color:var(--ink-faint);font-style:italic;}

  /* 7번 수정사항: 네 번째 이미지 스타일의 Contact / Footer 디자인 */
  .contact-footer-section{
    position:relative;
    min-height:70vh;
    border-top:1px solid var(--line);
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    padding:8vh 6vw 4vh;
    overflow:hidden;
    background:radial-gradient(circle at center, rgba(232,179,79,.05), transparent 70%);
  }

  /* 중앙 빛나는 동그라미 오라 */
  .center-ring-container{
    position:absolute;
    top:45%;
    left:50%;
    transform:translate(-50%, -50%);
    width:min(400px, 60vw);
    height:min(400px, 60vw);
    pointer-events:none;
  }
  .center-ring{
    width:100%;
    height:100%;
    border-radius:50%;
    border:2px solid rgba(232,179,79,0.6);
    box-shadow:0 0 50px rgba(232,179,79,0.3), inset 0 0 30px rgba(232,179,79,0.2);
    position:relative;
  }
  .center-ring::after{
    content:'';
    position:absolute;
    inset:-10px;
    border-radius:50%;
    border:1px solid rgba(127,216,208,0.3);
  }

  /* 하단 바 커스텀 */
  .footer-bottom-bar{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    width:100%;
    z-index:2;
    flex-wrap:wrap;
    gap:20px;
    margin-top:auto;
  }

  /* 왼쪽: 저작권 & 이메일 (Outlook 커넥트) */
  .footer-left-info{
    display:flex;
    flex-direction:column;
    gap:12px;
  }
  .footer-copyright{
    color:var(--ink-faint);
    font-size:12px;
  }
  .footer-email{
    color:var(--ink);
    font-size:14px;
    letter-spacing:.05em;
    text-decoration:none;
    transition:color .25s;
  }
  .footer-email:hover{
    color:var(--amber);
  }

  /* 오른쪽: 소셜 아이콘 동그라미 & To top */
  .footer-right-info{
    display:flex;
    align-items:center;
    gap:24px;
  }
  .social-circles{
    display:flex;
    gap:12px;
  }
  .social-btn{
    width:38px;
    height:38px;
    border-radius:50%;
    border:1px solid var(--line);
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--ink-dim);
    text-decoration:none;
    font-size:11px;
    letter-spacing:.05em;
    transition:all .25s;
  }
  .social-btn:hover{
    border-color:var(--amber);
    color:var(--amber);
    box-shadow:0 0 10px rgba(232,179,79,0.2);
  }
  .to-top-btn{
    color:var(--ink-dim);
    text-decoration:none;
    font-size:12px;
    letter-spacing:.08em;
    display:flex;
    align-items:center;
    gap:6px;
    transition:color .25s;
  }
  .to-top-btn:hover{
    color:var(--amber);
  }

  @media (max-width:900px){
    .rail{display:none;}
    .topnav{display:none;}
    .world{position:relative;right:auto;top:auto;transform:none;margin:40px auto 0;width:min(78vw,320px);height:min(78vw,320px);}
    .hero{padding-top:14vh;}
    .proj-grid{grid-template-columns:1fr;gap:40px;}
    .proj.flip .proj-visual,.proj.flip .proj-copy{order:0;}
    .footer-bottom-bar{flex-direction:column;align-items:flex-start;gap:24px;}
    .footer-right-info{width:100%;justify-content:space-between;}
  }
</style>
</head>
