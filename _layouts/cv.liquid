<!-- ===== CV 전용 커스텀 스타일 (Dark Theme & UI) ===== -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,340,500;9..144,600&family=Caveat:wght@600&family=Inter:wght@400;500;600&display=swap');

  :root {
    --bg: #0b0f14;
    --line: rgba(238, 242, 240, .1);
    --ink: #eef2f0;
    --ink-dim: rgba(238, 242, 240, .55);
    --ink-faint: rgba(238, 242, 240, .32);
    --amber: #e8b34f;
    --cyan: #7fd8d0;
  }

  /* default 레이아웃 배경색 및 기본 폰트 오버라이드 */
  body {
    background-color: var(--bg) !important;
    color: var(--ink);
    font-family: 'Inter', sans-serif;
  }

  a { color: inherit; }

  /* 우측 내비게이션 레일 */
  .rail {
    position: fixed; right: 5vw; top: 50%; transform: translateY(-50%);
    z-index: 20; display: flex; flex-direction: column; gap: 20px;
  }
  .rail a {
    font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--ink-dim); text-decoration: none; display: flex; align-items: center; gap: 10px; transition: color .25s;
  }
  .rail a .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--ink-dim); transition: .25s; }
  .rail a.active, .rail a:hover { color: var(--amber); }
  .rail a.active .dot, .rail a:hover .dot { background: var(--amber); box-shadow: 0 0 8px var(--amber); }

  .doodle { position: absolute; pointer-events: none; opacity: .85; }
  .signature { font-family: 'Caveat', cursive; color: var(--amber); }

  /* Hero 섹션 */
  .cv-hero {
    position: relative; padding: 10vh 5vw 4vh; text-align: center;
    background: radial-gradient(ellipse at 50% 30%, rgba(127, 216, 208, .07), transparent 60%);
  }
  .cv-hero .eyebrow { font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: var(--cyan); margin-bottom: 20px; }
  .cv-hero .giant { font-family: 'Fraunces', serif; font-weight: 600; font-size: clamp(60px, 12vw, 160px); line-height: .86; letter-spacing: -.02em; position: relative; display: inline-block; }
  .pdf-btn {
    margin-top: 30px; display: inline-flex; align-items: center; gap: 10px; font-size: 12px; letter-spacing: .12em; text-transform: uppercase;
    color: var(--ink-dim); text-decoration: none; border: 1px solid var(--line); border-radius: 40px; padding: 11px 22px; transition: .25s;
  }
  .pdf-btn:hover { color: var(--amber); border-color: var(--amber); }

  /* Main 컨테이너 설정 */
  .cv-wrapper { max-width: 1000px; margin: 0 auto; padding: 4vh 0; }
  .col-head { font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--amber); margin-bottom: 26px; }

  /* Intro */
  .intro { display: flex; gap: 48px; align-items: center; flex-wrap: wrap; position: relative; padding-bottom: 9vh; border-bottom: 1px solid var(--line); }
  .portrait {
    width: 190px; height: 190px; border-radius: 50%; flex-shrink: 0;
    background-image: url("{{ '/assets/img/prof_pic.jpg' | relative_url }}"); background-size: cover; background-position: center;
    filter: grayscale(1) contrast(1.05); border: 1px solid rgba(127, 216, 208, .4); box-shadow: 0 0 0 6px rgba(127, 216, 208, .06);
  }
  .intro-txt { flex: 1; min-width: 280px; }
  .intro-txt .hi { font-family: 'Fraunces', serif; font-size: 22px; margin-bottom: 14px; }
  .intro-txt .summary { font-size: 16px; line-height: 1.8; color: var(--cyan); font-style: italic; max-width: 560px; }
  .intro .signature { position: absolute; right: 6%; bottom: 5vh; font-size: 34px; transform: rotate(-6deg); }

  /* Section Shell */
  section.block { padding: 9vh 0; border-bottom: 1px solid var(--line); }
  .two { display: grid; grid-template-columns: 280px 1fr; gap: 56px; }

  /* Contact */
  .contact-list { display: flex; flex-direction: column; gap: 16px; }
  .contact-list .item { font-size: 14px; color: var(--ink-dim); }
  .contact-list .item b { display: block; color: var(--ink-faint); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 3px; font-weight: 500; }
  .contact-list a { color: var(--ink-dim); text-decoration: none; border-bottom: 1px solid var(--line); }
  .contact-list a:hover { color: var(--amber); border-color: var(--amber); }

  /* Timeline */
  .timeline { position: relative; padding-left: 26px; }
  .timeline::before { content: ""; position: absolute; left: 4px; top: 6px; bottom: 6px; width: 1px; background: var(--line); }
  .tl-item { position: relative; padding: 0 0 34px; }
  .tl-item:last-child { padding-bottom: 0; }
  .tl-item::before { content: ""; position: absolute; left: -26px; top: 6px; width: 9px; height: 9px; border-radius: 50%; background: var(--bg); border: 1px solid var(--amber); }
  .tl-date { font-size: 11px; letter-spacing: .06em; color: var(--ink-faint); margin-bottom: 6px; }
  .tl-role { font-family: 'Fraunces', serif; font-size: 18px; margin-bottom: 3px; }
  .tl-org { font-size: 13px; color: var(--cyan); margin-bottom: 8px; }
  .tl-desc { font-size: 13px; color: var(--ink-dim); line-height: 1.65; margin-bottom: 8px; max-width: 600px; }
  .tl-item ul { list-style: none; }
  .tl-item li { font-size: 13px; color: var(--ink-dim); line-height: 1.6; padding-left: 14px; position: relative; margin-bottom: 4px; }
  .tl-item li::before { content: "–"; position: absolute; left: 0; color: var(--ink-faint); }

  /* Entry Stack */
  .entry { padding: 22px 0; border-top: 1px solid var(--line); }
  section.block .entry:last-child { border-bottom: 1px solid var(--line); }
  .entry-year { font-size: 11px; letter-spacing: .06em; color: var(--ink-faint); margin-bottom: 5px; }
  .entry-title { font-family: 'Fraunces', serif; font-size: 17px; margin-bottom: 2px; }
  .entry-title a { border-bottom: 1px solid var(--line); text-decoration: none; }
  .entry-title a:hover { color: var(--amber); border-color: var(--amber); }
  .entry-org { font-size: 13px; color: var(--cyan); margin-bottom: 8px; }
  .entry-desc { font-size: 13px; color: var(--ink-dim); line-height: 1.65; max-width: 640px; }
  .entry ul { list-style: none; margin-top: 8px; }
  .entry li { font-size: 13px; color: var(--ink-dim); padding-left: 14px; position: relative; margin-bottom: 4px; }
  .entry li::before { content: "–"; position: absolute; left: 0; color: var(--ink-faint); }

  /* Chips */
  .skill-group { margin-bottom: 26px; }
  .skill-group:last-child { margin-bottom: 0; }
  .skill-group h4 { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-faint); margin: 0 0 12px; font-weight: 500; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { font-size: 12.5px; color: var(--ink-dim); border: 1px solid var(--line); border-radius: 40px; padding: 8px 15px; transition: .25s; }
  .chip:hover { color: var(--amber); border-color: var(--amber); }

  /* Closing */
  .closing { position: relative; text-align: center; padding: 12vh 0 6vh; }
  .closing .big { font-family: 'Fraunces', serif; font-weight: 600; font-size: clamp(40px, 8vw, 104px); line-height: .95; letter-spacing: -.01em; }
  .closing .scatter { margin-top: 22px; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 22px; }
  .closing .scatter span { font-family: 'Caveat', cursive; font-size: 22px; color: var(--cyan); opacity: .75; }
  .closing .scatter span:nth-child(2n) { color: var(--amber); transform: rotate(-4deg); }

  @media (max-width: 860px) {
    .rail { display: none; }
    .two { grid-template-columns: 1fr; gap: 40px; }
    .intro .signature { position: static; display: inline-block; margin-top: 14px; }
  }
</style>

