  <!-- ===== LICENSE ===== -->
  <section class="block">
    <div class="col-head">LICENSE</div>
    <div class="entry">
      <div class="entry-year">1905</div>
      <div class="entry-title"><a href="https://en.wikisource.org/wiki/Translation:On_the_Electrodynamics_of_Moving_Bodies">Zur Elektrodynamik bewegter Körper</a></div>
