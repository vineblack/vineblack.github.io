  </section>

  <!-- ===== CONTACT + EXPERIENCE ===== -->
  <section class="block two" id="exp">
    <div>
      <div class="col-head">Contact</div>
      <div class="contact-list">
        <div class="item"><b>Name</b>Youngeun Lee</div>
        <div class="item"><b>Professional Title</b>Narrative 3D Environment Artist</div>
        <div class="item"><b>Email</b><a href="mailto:llstella674@gmail.com">llstella674@gmail.com</a></div>
        <div class="item"><b>Location</b>Seoul, South Korea</div>
      </div>
    </div>

    <div>
      <div class="col-head">Experience</div>
      <div class="timeline">
        <div class="tl-item">
          <div class="tl-date">1933 - 1955 · Princeton University, NJ</div>
          <div class="tl-role">Professor of Theoretical Physics</div>
