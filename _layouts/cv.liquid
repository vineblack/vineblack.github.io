          <ul>
            <li>Relativity</li>
            <li>Description 2.</li>
          </ul>
        </div>
        <div class="tl-item">
          <div class="tl-date">1933 - 1933 · Pasadena, California, US</div>
          <div class="tl-role">Visiting Professor</div>
          <div class="tl-org">California Institute of Technology</div>
          <ul>
            <li>Description 1.</li>
            <li>Description 2.</li>
          </ul>
        </div>
        <div class="tl-item">
          <div class="tl-date">1917 - 1933 · Berlin, Germany</div>
          <div class="tl-role">Director</div>
          <div class="tl-org">Kaiser Wilhelm Institute for Physics</div>
        </div>
        <div class="tl-item">
          <div class="tl-date">1911 - 1917 · Prague, Czechoslovakia</div>
          <div class="tl-role">Professor of Theoretical Physics</div>
          <div class="tl-org">Karl-Ferdinand University</div>
        </div>
        <div class="tl-item">
          <div class="tl-date">1909 - 1911 · Zurich, Switzerland</div>
          <div class="tl-role">Associate Professor of Theoretical Physics</div>
          <div class="tl-org">University of Zurich</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== EDUCATION ===== -->
  <section class="block" id="edu">
    <div class="col-head">Education</div>
    <div class="timeline">
      <div class="tl-item">
        <div class="tl-date">2022.3 - 2028.2 · Anseong, South Korea</div>
        <div class="tl-role">Art &amp; Technology, Double Major in Creative Writing</a></div>
        <div class="tl-org">Chung-Ang University</div>
        <div class="tl-desc">Bachelor's Degree</div>
      </div>
      <div class="tl-item">
        <div class="tl-date">2025.9 - 2026.2 · Seoul, South Korea</div>
        <div class="tl-role">Maya Hard Surface</div>
        <div class="tl-org">Megastudy Computer Academy</div>
      </div>
    </div>
  </section>

  <!-- ===== AWARDS ===== -->
  <section class="block" id="awards">
    <div class="col-head">Awards</div>
    <div class="entry">
      <div class="entry-year">1921</div>
      <div class="entry-title"><a href="https://www.nobelprize.org">Nobel Prize in Physics</a></div>
      <div class="entry-org">Royal Swedish Academy of Sciences</div>
      <div class="entry-desc">The Nobel Prizes are awarded to 'those who conferred the greatest benefit to humankind.'</div>
