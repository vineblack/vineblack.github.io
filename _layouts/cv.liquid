---
# CV 전용 독립 레이아웃 — WorldBuilder 디자인 유지 + 예시 데이터 포함
---
<!DOCTYPE html>
<html lang="{{ site.lang | default: 'ko' }}">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ page.title | default: site.title }}</title>

<!-- ===== al-folio head 재사용 (SEO·favicon·보안) ===== -->
{% include metadata.liquid %}
<meta
  http-equiv="Content-Security-Policy"
  content="default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; media-src 'self' https:; frame-src 'self' https:; connect-src 'self' https:;"
>
{% if site.icon.size <= 4 %}
  <link rel="shortcut icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>">
{% elsif site.icon != blank %}
  <link rel="shortcut icon" href="{{ site.icon | prepend: '/assets/img/' | relative_url | bust_file_cache }}">
{% endif %}
<link rel="canonical" href="{{ page.url | replace:'index.html','' | absolute_url }}">

<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,340,500;9..144,600&family=Caveat:wght@600&family=Inter:wght@400;500;600&display=swap');

  :root{
    --bg:#0b0f14;
    --line:rgba(238,242,240,.1);
    --ink:#eef2f0;
    --ink-dim:rgba(238,242,240,.55);
    --ink-faint:rgba(238,242,240,.32);
    --amber:#e8b34f;
    --cyan:#7fd8d0;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html,body{background:var(--bg) !important;color:var(--ink) !important;font-family:'Inter',sans-serif;overflow-x:hidden;}
  a{color:inherit;}

  /* ---- chrome ---- */
  .topbar{position:fixed;top:0;left:0;right:0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:26px 5vw;mix-blend-mode:difference;}
  .logo{font-family:'Fraunces',serif;font-size:15px;letter-spacing:.02em;}
  .logo b{font-weight:600;}
  .topnav{display:flex;gap:22px;font-size:12px;letter-spacing:.12em;text-transform:uppercase;}
  .topnav a{text-decoration:none;color:var(--ink);opacity:.8;}
  .topnav a:hover,.topnav a.active{opacity:1;color:var(--amber);}

  .rail{position:fixed;right:5vw;top:50%;transform:translateY(-50%);z-index:20;display:flex;flex-direction:column;gap:20px;}
  .rail a{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-dim);text-decoration:none;display:flex;align-items:center;gap:10px;transition:color .25s;}
  .rail a .dot{width:5px;height:5px;border-radius:50%;background:var(--ink-dim);transition:.25s;}
  .rail a.active,.rail a:hover{color:var(--amber);}
  .rail a.active .dot,.rail a:hover .dot{background:var(--amber);box-shadow:0 0 8px var(--amber);}

  .doodle{position:absolute;pointer-events:none;opacity:.85;}
  .signature{font-family:'Caveat',cursive;color:var(--amber);}

  /* ---- hero ---- */
  .cv-hero{position:relative;padding:20vh 5vw 4vh;text-align:center;
    background:radial-gradient(ellipse at 50% 30%, rgba(127,216,208,.07), transparent 60%);}
  .cv-hero .eyebrow{font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--cyan);margin-bottom:20px;}
  .cv-hero .giant{font-family:'Fraunces',serif;font-weight:600;font-size:clamp(72px,16vw,220px);line-height:.86;letter-spacing:-.02em;position:relative;display:inline-block;color:var(--ink);}
  .pdf-btn{margin-top:30px;display:inline-flex;align-items:center;gap:10px;font-size:12px;letter-spacing:.12em;text-transform:uppercase;
    color:var(--ink-dim);text-decoration:none;border:1px solid var(--line);border-radius:40px;padding:11px 22px;transition:.25s;}
  .pdf-btn:hover{color:var(--amber);border-color:var(--amber);}

  /* ---- layout wrap ---- */
  main{max-width:1000px;margin:0 auto;padding:6vh 5vw 4vh;}
  .col-head{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--amber);margin-bottom:26px;}
  .ph{color:var(--ink-faint);}

  /* ---- intro ---- */
  .intro{display:flex;gap:48px;align-items:center;flex-wrap:wrap;position:relative;padding-bottom:9vh;border-bottom:1px solid var(--line);}
  .portrait{width:190px;height:190px;border-radius:50%;flex-shrink:0;
    background-image:url('{{ "/assets/img/prof_pic.jpg" | relative_url }}');background-size:cover;background-position:center;
    filter:grayscale(1) contrast(1.05);border:1px solid rgba(127,216,208,.4);box-shadow:0 0 0 6px rgba(127,216,208,.06);}
  .intro-txt{flex:1;min-width:280px;}
  .intro-txt .hi{font-family:'Fraunces',serif;font-size:22px;margin-bottom:14px;color:var(--ink);}
  .intro-txt .summary{font-size:16px;line-height:1.8;color:var(--cyan);font-style:italic;max-width:560px;}
  .intro .signature{position:absolute;right:6%;bottom:5vh;font-size:34px;transform:rotate(-6deg);}

  /* ---- section shell ---- */
  section.block{padding:9vh 0;border-bottom:1px solid var(--line);}
  .two{display:grid;grid-template-columns:280px 1fr;gap:56px;}

  /* ---- contact ---- */
  .contact-list{display:flex;flex-direction:column;gap:16px;}
  .contact-list .item{font-size:14px;color:var(--ink-dim);}
  .contact-list .item b{display:block;color:var(--ink-faint);font-size:11px;letter-spacing:.08em;text-transform:uppercase;margin-bottom:3px;font-weight:500;}
  .contact-list a{color:var(--ink-dim);text-decoration:none;border-bottom:1px solid var(--line);}
  .contact-list a:hover{color:var(--amber);border-color:var(--amber);}

  /* ---- timeline (experience / education) ---- */
  .timeline{position:relative;padding-left:26px;}
  .timeline::before{content:"";position:absolute;left:4px;top:6px;bottom:6px;width:1px;background:var(--line);}
  .tl-item{position:relative;padding:0 0 34px;}
  .tl-item:last-child{padding-bottom:0;}
  .tl-item::before{content:"";position:absolute;left:-26px;top:6px;width:9px;height:9px;border-radius:50%;background:var(--bg);border:1px solid var(--amber);}
  .tl-date{font-size:11px;letter-spacing:.06em;color:var(--ink-faint);margin-bottom:6px;}
  .tl-role{font-family:'Fraunces',serif;font-size:18px;margin-bottom:3px;color:var(--ink);}
  .tl-org{font-size:13px;color:var(--cyan);margin-bottom:8px;}
  .tl-desc{font-size:13px;color:var(--ink-dim);line-height:1.65;margin-bottom:8px;max-width:600px;}
  .tl-item ul{list-style:none;}
  .tl-item li{font-size:13px;color:var(--ink-dim);line-height:1.6;padding-left:14px;position:relative;margin-bottom:4px;}
  .tl-item li::before{content:"–";position:absolute;left:0;color:var(--ink-faint);}

  /* ---- entry stack ---- */
  .entry{padding:22px 0;border-top:1px solid var(--line);}
  section.block .entry:last-child{border-bottom:1px solid var(--line);}
  .entry-year{font-size:11px;letter-spacing:.06em;color:var(--ink-faint);margin-bottom:5px;}
  .entry-title{font-family:'Fraunces',serif;font-size:17px;margin-bottom:2px;color:var(--ink);}
  .entry-title a{border-bottom:1px solid var(--line);text-decoration:none;}
  .entry-title a:hover{color:var(--amber);border-color:var(--amber);}
  .entry-org{font-size:13px;color:var(--cyan);margin-bottom:8px;}
  .entry-desc{font-size:13px;color:var(--ink-dim);line-height:1.65;max-width:640px;}
  .entry ul{list-style:none;margin-top:8px;}
  .entry li{font-size:13px;color:var(--ink-dim);padding-left:14px;position:relative;margin-bottom:4px;}
  .entry li::before{content:"–";position:absolute;left:0;color:var(--ink-faint);}

  /* ---- chips ---- */
  .skill-group{margin-bottom:26px;}
  .skill-group:last-child{margin-bottom:0;}
  .skill-group h4{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-faint);margin:0 0 12px;font-weight:500;}
  .chips{display:flex;flex-wrap:wrap;gap:10px;}
  .chip{font-size:12.5px;color:var(--ink-dim);border:1px solid var(--line);border-radius:40px;padding:8px 15px;transition:.25s;}
  .chip:hover{color:var(--amber);border-color:var(--amber);}

  /* ---- closing ---- */
  .closing{position:relative;text-align:center;padding:16vh 5vw 6vh;}
  .closing .big{font-family:'Fraunces',serif;font-weight:600;font-size:clamp(40px,8vw,104px);line-height:.95;letter-spacing:-.01em;color:var(--ink);}
  .closing .scatter{margin-top:22px;display:flex;flex-wrap:wrap;justify-content:center;gap:8px 22px;}
  .closing .scatter span{font-family:'Caveat',cursive;font-size:22px;color:var(--cyan);opacity:.75;}
  .closing .scatter span:nth-child(2n){color:var(--amber);transform:rotate(-4deg);}

  footer{max-width:1000px;margin:0 auto;padding:2vh 5vw 7vh;display:flex;justify-content:space-between;flex-wrap:wrap;gap:14px;border-top:1px solid var(--line);}
  footer p{color:var(--ink-faint);font-size:12px;}
  footer .socials{display:flex;gap:16px;font-size:12px;}
  footer a{color:var(--ink-dim);text-decoration:none;}
  footer a:hover{color:var(--amber);}

  @media (max-width:860px){
    .rail{display:none;} .topnav{display:none;}
    .two{grid-template-columns:1fr;gap:40px;}
    .intro .signature{position:static;display:inline-block;margin-top:14px;}
  }
</style>
</head>
<body>

<div class="topbar">
  <div class="logo"><b>Youngeun</b> Lee</div>
  <nav class="topnav">
    <a href="{{ '/' | relative_url }}">About</a>
    <a href="{{ '/blog/' | relative_url }}">Blog</a>
    <a href="{{ '/Lab/' | relative_url }}">Lab</a>
    <a href="{{ '/Archive/' | relative_url }}">Archive</a>
    <a href="{{ '/cv/' | relative_url }}" class="active">CV</a>
  </nav>
</div>

<nav class="rail">
  <a href="#top" class="active"><span class="dot"></span>Intro</a>
  <a href="#exp"><span class="dot"></span>Experience</a>
  <a href="#edu"><span class="dot"></span>Education</a>
  <a href="#awards"><span class="dot"></span>Awards</a>
  <a href="#license"><span class="dot"></span>License</a>
  <a href="#skills"><span class="dot"></span>Skills</a>
</nav>

<!-- ===== HERO ===== -->
<section class="cv-hero" id="top">
  <div class="eyebrow">CV · 2026</div>
  <h1 class="giant">Profile
    <svg class="doodle" style="top:-6%;left:-4%;width:38px" viewBox="0 0 24 24"><path d="M12 2l2.2 6.6L21 11l-6.8 2.4L12 20l-2.2-6.6L3 11l6.8-2.4z" fill="var(--cyan)"/></svg>
    <svg class="doodle" style="top:-12%;right:2%;width:30px" viewBox="0 0 24 24"><path d="M12 3l1.8 5.4L19 10l-5.2 1.6L12 17l-1.8-5.4L5 10l5.2-1.6z" fill="var(--amber)"/></svg>
    <svg class="doodle" style="bottom:2%;right:-3%;width:26px" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="9" cy="10" r="1" fill="var(--cyan)"/><circle cx="15" cy="10" r="1" fill="var(--cyan)"/><path d="M8.5 14c1.5 1.6 5.5 1.6 7 0" stroke-linecap="round"/></svg>
  </h1>
  <br>
  <!-- PDF 버튼 유지 -->
  <a class="pdf-btn" href="{{ '/assets/pdf/example_pdf.pdf' | relative_url }}">↓ Download PDF</a>
</section>

<main>

  <!-- ===== INTRO / SUMMARY ===== -->
  <section class="intro">
    <div class="portrait"></div>
