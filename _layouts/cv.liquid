      </div>
    </div>
  </section>

</main>

<!-- ===== CLOSING ===== -->
<section class="closing">
  <div class="big">World Building</div>
  <div class="scatter">
    <span>environment</span><span>narrative</span><span>3d</span><span>logic</span><span>archive</span><span>worldsystem</span>
  </div>
</section>

<footer>
  <p>© 2026 Youngeun Lee. Powered by Jekyll with al-folio theme. Hosted by GitHub Pages.</p>
  <div class="socials">
    <a href="https://github.com/bigeco">GitHub</a>
    <a href="{{ '/' | relative_url }}">About</a>
  </div>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script>
  gsap.registerPlugin(ScrollTrigger);

  gsap.from('.cv-hero .eyebrow, .cv-hero .giant, .cv-hero .pdf-btn', {
    y: 22, opacity: 0, stagger: .1, duration: .8, ease: 'power2.out'
  });

  gsap.utils.toArray('.intro, section.block, .closing').forEach(function(sec){
    gsap.from(sec.querySelectorAll('.portrait, .intro-txt, .col-head, .contact-list .item, .tl-item, .entry, .skill-group, .big, .scatter'), {
      y: 18, opacity: 0, duration: .7, stagger: .04, ease: 'power2.out',
      scrollTrigger: { trigger: sec, start: 'top 85%' }
    });
  });

  var ids = ['top','exp','edu','awards','skills'];
  ids.forEach(function(id){
    var el = document.getElementById(id);
    if(!el) return;
    ScrollTrigger.create({
      trigger: el, start: 'top center', end: 'bottom center',
      onToggle: function(self){
        if(!self.isActive) return;
        document.querySelectorAll('.rail a').forEach(function(a){ a.classList.remove('active'); });
        var link = document.querySelector('.rail a[href="#' + id + '"]');
        if(link) link.classList.add('active');
      }
    });
  });
</script>
</body>
</html>
