---
layout: default
title: CV
permalink: /cv/
nav: true
nav_order: 5
cv_pdf: example_pdf.pdf # assets/pdf/ 안에 위치한 PDF 파일명
---

<div class="post">
  <!-- ===== Header & PDF Download Button ===== -->
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a
          href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-sm z-depth-1 float-right"
          style="background-color: var(--global-theme-color); color: var(--global-bg-color); font-weight: 600; border-radius: 20px; padding: 6px 16px;"
        >
          <i class="fa-solid fa-file-pdf"></i> Download PDF
        </a>
      {% endif %}
    </h1>
    <p class="post-description">Curriculum Vitæ · 2026</p>
  </header>

