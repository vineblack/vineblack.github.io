---
# 이 파일은 다른 레이아웃에 감싸이지 않는 "독립 레이아웃"입니다.
# (al-folio 기본 헤더/네비/다크모드 대신, 아래 디자인이 페이지 전체를 차지합니다)
---
<!DOCTYPE html>
<html lang="{{ site.lang | default: 'ko' }}">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ page.title | default: site.title }}</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,340,500;9..144,600&family=Caveat:wght@600&family=Inter:wght@400;500;600&display=swap');

  :root{
    --bg:#0b0f14;
    --panel:#12181f;
    --line:rgba(238,242,240,.1);
    --ink:#eef2f0;
    --ink-dim:rgba(238,242,240,.55);
    --ink-faint:rgba(238,242,240,.32);
    --amber:#e8b34f;
    --cyan:#7fd8d0;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html,body{background:var(--bg);color:var(--ink);font-family:'Inter',sans-serif;overflow-x:hidden;}
  a{color:inherit;}

  .topbar{position:fixed;top:0;left:0;right:0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:26px 5vw;mix-blend-mode:difference;}
  .logo{font-family:'Fraunces',serif;font-size:15px;}
  .logo b{font-weight:600;}
  .topnav{display:flex;gap:22px;font-size:12px;letter-spacing:.12em;text-transform:uppercase;}
  .topnav a{text-decoration:none;color:var(--ink);opacity:.8;}
  .topnav a:hover{opacity:1;}

  .rail{position:fixed;right:5vw;top:50%;transform:translateY(-50%);z-index:20;display:flex;flex-direction:column;gap:22px;}
  .rail a{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-dim);text-decoration:none;display:flex;align-items:center;gap:10px;}
  .rail a .dot{width:5px;height:5px;border-radius:50%;background:var(--ink-dim);}
  .rail a.active,.rail a:hover{color:var(--amber);}
  .rail a.active .dot,.rail a:hover .dot{background:var(--amber);box-shadow:0 0 8px var(--amber);}

  .hero{min-height:78vh;display:flex;flex-direction:column;justify-content:center;padding:14vh 5vw 4vh;background:
      radial-gradient(ellipse at 70% 30%, rgba(127,216,208,.08), transparent 55%);}
  .eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--cyan);margin-bottom:16px;display:flex;align-items:center;gap:10px;}
  .eyebrow::before{content:"";width:24px;height:1px;background:var(--cyan);}
  .giant{font-family:'Fraunces',serif;font-weight:340;font-size:clamp(48px,9vw,110px);line-height:.9;}
  .hero-sub{margin-top:20px;max-width:460px;color:var(--ink-dim);font-size:15px;line-height:1.75;}

  main{max-width:1040px;margin:0 auto;padding:6vh 5vw 10vh;}
  .tag{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--amber);margin-bottom:8px;}
  .block-title{font-family:'Fraunces',serif;font-weight:500;font-size:clamp(24px,3vw,34px);margin-bottom:60px;}

  /* ---- pinboard / scrapbook motion section ---- */
  .board{position:relative;padding:20px 0 40px;}
  .board::before{
    content:"";position:absolute;inset:-30px 0 -10px;z-index:-1;border-radius:6px;
    background:
      linear-gradient(var(--panel),var(--panel)),
      repeating-linear-gradient(0deg, transparent 0 38px, rgba(255,255,255,.02) 38px 39px);
    border:1px solid var(--line);
  }
  .clip-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:34px;padding:44px 34px;}
  .clip{position:relative;background:#171e26;border:1px solid var(--line);border-radius:2px;padding:18px 16px 20px;
    box-shadow:0 14px 26px rgba(0,0,0,.45);will-change:transform,opacity;}
  .clip:nth-child(1){transform:rotate(-2.4deg);}
  .clip:nth-child(2){transform:rotate(1.6deg);}
  .clip:nth-child(3){transform:rotate(-1.2deg);}
  .clip:nth-child(4){transform:rotate(2deg);}

  .pin{position:absolute;top:-9px;left:22px;width:14px;height:14px;border-radius:50%;
    background:radial-gradient(circle at 32% 30%, #fff6de, var(--amber) 55%, #8a611f 100%);
    box-shadow:0 3px 5px rgba(0,0,0,.5);}
  .tape{position:absolute;top:-12px;right:14px;width:58px;height:22px;
    background:linear-gradient(rgba(127,216,208,.16), rgba(127,216,208,.1));
    border:1px solid rgba(127,216,208,.25);transform:rotate(8deg);}

  .thumb{width:100%;aspect-ratio:4/3;border-radius:2px;margin-bottom:14px;
    background:linear-gradient(150deg,#1c2530,#0e1319);border:1px solid var(--line);}
  .clip h3{font-family:'Fraunces',serif;font-size:18px;margin-bottom:6px;}
  .clip p{font-size:12.5px;color:var(--ink-dim);line-height:1.6;}
  .clip .note{position:absolute;bottom:-16px;right:10px;font-family:'Caveat',cursive;font-size:16px;color:var(--amber);transform:rotate(-4deg);}

  .thread{position:absolute;pointer-events:none;z-index:-1;}

  footer{max-width:1040px;margin:0 auto;padding:8vh 5vw 6vh;display:flex;justify-content:space-between;flex-wrap:wrap;gap:14px;}
  footer p{color:var(--ink-faint);font-size:12px;}

  @media (max-width:820px){ .rail{display:none;} .topnav{display:none;} }
</style>
</head>
<body>

<div class="topbar">
  <div class="logo"><b>Youngeun</b> Lee</div>
  <!-- ↓ al-folio의 다른 페이지로 가는 네비게이션 (원래 사이트 메뉴를 잃지 않도록 연결) -->
  <nav class="topnav">
    <a href="{{ '/' | relative_url }}">About</a>
    <a href="{{ '/blog/' | relative_url }}">Blog</a>
    <a href="{{ '/Lab/' | relative_url }}">Lab</a>
    <a href="{{ '/Archive/' | relative_url }}">Archive</a>
    <a href="{{ '/cv/' | relative_url }}">CV</a>
  </nav>
</div>

<nav class="rail">
  <a href="#hero" class="active"><span class="dot"></span>About</a>
  <a href="#work"><span class="dot"></span>Work</a>
  <a href="#contact"><span class="dot"></span>Contact</a>
</nav>

<section class="hero" id="hero">
  <div class="eyebrow">Narrative 3D Environment Artist</div>
  <h1 class="giant">World Builder</h1>
  <!-- ✏️ 아래 소개 문구를 자유롭게 수정하세요 -->
  <p class="hero-sub">이야기가 그려지는 게 아니라, 그 안에서 살아지는 공간을 설계합니다. 아래는 그 세계를 기록해온 필드 아카이브입니다.</p>
</section>

<main>
  <section id="work">
    <div class="tag">Selected Art Work</div>
    <h2 class="block-title">필드 아카이브 — 스크롤하면 핀으로 꽂히듯 기록이 펼쳐집니다</h2>

    <div class="board">
      <div class="clip-grid">
        <!-- ✏️ 작업물 카드: h3=제목, p=분류·연도, note=번호. 필요하면 .clip 블록을 복제/삭제하세요 -->
        <div class="clip"><span class="pin"></span><div class="thumb"></div><h3>Field of Dusk</h3><p>Environment · 2026</p><span class="note">01</span></div>
        <div class="clip"><span class="tape"></span><div class="thumb"></div><h3>Interior Weather</h3><p>Narrative · 2025</p><span class="note">02</span></div>
        <div class="clip"><span class="pin"></span><div class="thumb"></div><h3>Static Coastline</h3><p>World System · 2025</p><span class="note">03</span></div>
        <div class="clip"><span class="tape"></span><div class="thumb"></div><h3>Archive of Rooms</h3><p>Environment · 2024</p><span class="note">04</span></div>
      </div>
    </div>
  </section>

  {{ content }}
</main>

<footer id="contact"><p>© 2026 Youngeun Lee — field archive concept demo</p></footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script>
  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll('.clip').forEach(function(el, i){
    gsap.fromTo(el,
      { y: 70, opacity: 0, rotate: (i % 2 === 0 ? -14 : 14), scale: .9 },
      {
        y: 0, opacity: 1, rotate: (i % 4 === 0 ? -2.4 : i % 4 === 1 ? 1.6 : i % 4 === 2 ? -1.2 : 2), scale: 1,
        duration: 0.9, delay: i * 0.08, ease: 'back.out(1.6)',
        scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none reverse' }
      }
    );
  });

  gsap.from('.hero .eyebrow, .hero .giant, .hero .hero-sub', {
    y: 20, opacity: 0, stagger: .12, duration: .8, ease: 'power2.out'
  });
</script>
</body>
</html>
