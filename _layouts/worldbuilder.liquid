---
# 다른 레이아웃에 감싸이지 않는 독립 레이아웃입니다.
# al-folio 기본 헤더/네비 대신 아래 디자인이 페이지 전체를 차지합니다.
---
<!DOCTYPE html>
<html lang="{{ site.lang | default: 'ko' }}">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ page.title | default: site.title }}</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,340,500;9..144,600&family=Inter:wght@400;500;600&display=swap');

  :root{
    --bg:#0b0f14;
    --line:rgba(238,242,240,.1);
    --ink:#eef2f0;
    --ink-dim:rgba(238,242,240,.55);
    --ink-faint:rgba(238,242,240,.32);
    --amber:#e8b34f;
    --cyan:#7fd8d0;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html,body{background:var(--bg);color:var(--ink);font-family:'Inter',sans-serif;overflow-x:hidden;}
  a{color:inherit;}

  /* ---- chrome ---- */
  .topbar{position:fixed;top:0;left:0;right:0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:26px 5vw;mix-blend-mode:difference;}
  .logo{font-family:'Fraunces',serif;font-size:15px;letter-spacing:.02em;}
  .logo b{font-weight:600;}
  .topnav{display:flex;gap:22px;font-size:12px;letter-spacing:.12em;text-transform:uppercase;}
  .topnav a{text-decoration:none;color:var(--ink);opacity:.8;}
  .topnav a:hover{opacity:1;}

  .rail{position:fixed;right:5vw;top:50%;transform:translateY(-50%);z-index:20;display:flex;flex-direction:column;gap:22px;}
  .rail a{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-dim);text-decoration:none;display:flex;align-items:center;gap:10px;transition:color .25s;}
  .rail a .dot{width:5px;height:5px;border-radius:50%;background:var(--ink-dim);transition:background .25s,box-shadow .25s;}
  .rail a.active,.rail a:hover{color:var(--amber);}
  .rail a.active .dot,.rail a:hover .dot{background:var(--amber);box-shadow:0 0 8px var(--amber);}

  /* ---- hero ---- */
  .hero{min-height:100vh;position:relative;display:flex;flex-direction:column;justify-content:center;padding:0 5vw;background:
      radial-gradient(ellipse at 70% 40%, rgba(127,216,208,.08), transparent 55%),
      radial-gradient(ellipse at 20% 70%, rgba(232,179,79,.06), transparent 50%);}
  .eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--cyan);margin-bottom:18px;display:flex;align-items:center;gap:10px;}
  .eyebrow::before{content:"";width:26px;height:1px;background:var(--cyan);}
  .giant{font-family:'Fraunces',serif;font-weight:340;font-size:clamp(64px,13vw,180px);line-height:.86;letter-spacing:-0.01em;}
  .giant .accent{font-weight:600;color:transparent;-webkit-text-stroke:1px var(--ink);}
  .hero-sub{margin-top:26px;max-width:420px;color:var(--ink-dim);font-size:15px;line-height:1.75;}

  .world{position:absolute;right:6vw;top:50%;transform:translateY(-50%);width:340px;height:340px;perspective:900px;}
  .world .ring{position:absolute;inset:0;border:1px solid rgba(127,216,208,.35);border-radius:50%;transform-style:preserve-3d;}
  .world .ring.r1{transform:rotateX(70deg) rotateZ(0deg);}
  .world .ring.r2{transform:rotateX(70deg) rotateZ(60deg);border-color:rgba(232,179,79,.3);}
  .world .ring.r3{transform:rotateX(70deg) rotateZ(120deg);}
  .world .core{position:absolute;left:50%;top:50%;width:64px;height:64px;margin:-32px;border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #fff, var(--cyan) 45%, transparent 75%);filter:blur(.3px);}
  .world .node{position:absolute;width:6px;height:6px;border-radius:50%;background:var(--amber);box-shadow:0 0 10px var(--amber);}

  .scroll-tag{position:absolute;bottom:34px;left:5vw;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-dim);}

  /* ---- content sections below hero ---- */
  main{padding:14vh 5vw 10vh;max-width:960px;margin:0 auto;}

  .profile{display:flex;gap:44px;align-items:flex-end;padding-bottom:8vh;border-bottom:1px solid var(--line);flex-wrap:wrap;}
  .avatar{width:132px;height:132px;border-radius:4px;background:linear-gradient(160deg,#1c2530,#0e1319);border:1px solid var(--line);flex-shrink:0;background-size:cover;background-position:center;}
  .id h2{font-family:'Fraunces',serif;font-weight:500;font-size:clamp(28px,4vw,42px);line-height:1.02;}
  .id .tagline{margin-top:14px;font-size:15px;color:var(--ink-dim);max-width:520px;line-height:1.7;}

  section.block{padding:9vh 0;border-bottom:1px solid var(--line);}
  .tag{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--amber);margin-bottom:22px;}
  .bio p{font-size:15px;line-height:1.9;color:var(--ink-dim);max-width:720px;margin-bottom:20px;}
  .bio p:last-child{margin-bottom:0;}
  .ph{color:var(--ink-faint);font-style:italic;}

  .stack{display:flex;flex-direction:column;}
  .row{display:flex;justify-content:space-between;align-items:baseline;gap:20px;padding:22px 0;border-top:1px solid var(--line);}
  .stack .row:last-child{border-bottom:1px solid var(--line);}
  .row .name{font-family:'Fraunces',serif;font-size:19px;flex:2;min-width:200px;}
  .row .desc{font-size:13px;color:var(--ink-dim);flex:2;}
  .row .meta{font-size:12px;letter-spacing:.06em;color:var(--ink-faint);white-space:nowrap;}

  .grp{margin-bottom:34px;}
  .grp:last-child{margin-bottom:0;}
  .grp h3{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-dim);margin-bottom:14px;}
  .grp ul{list-style:none;}
  .grp li{font-size:14px;color:var(--ink-dim);padding:10px 0;border-top:1px solid var(--line);}
  .grp li:last-child{border-bottom:1px solid var(--line);}
  .grp li b{color:var(--ink);font-weight:500;}

  footer{padding:8vh 5vw 6vh;max-width:960px;margin:0 auto;display:flex;justify-content:space-between;flex-wrap:wrap;gap:14px;}
  footer p{color:var(--ink-faint);font-size:12px;}
  footer .socials{display:flex;gap:16px;font-size:12px;}
  footer a{color:var(--ink-dim);text-decoration:none;}
  footer a:hover{color:var(--amber);}

  @media (max-width:820px){
    .rail{display:none;}
    .topnav{display:none;}
    .world{position:relative;right:auto;top:auto;transform:none;margin:40px auto 0;}
    .hero{padding-top:14vh;}
  }
</style>
</head>
<body>

<div class="topbar">
  <div class="logo"><b>Youngeun</b> Lee</div>
  <!-- al-folio의 다른 페이지로 가는 네비게이션 -->
  <nav class="topnav">
    <a href="{{ '/' | relative_url }}">About</a>
    <a href="{{ '/blog/' | relative_url }}">Blog</a>
    <a href="{{ '/Lab/' | relative_url }}">Lab</a>
    <a href="{{ '/Archive/' | relative_url }}">Archive</a>
    <a href="{{ '/cv/' | relative_url }}">CV</a>
  </nav>
</div>

<nav class="rail">
  <a href="#hero" class="active"><span class="dot"></span>About</a>
  <a href="#focus"><span class="dot"></span>Focus</a>
  <a href="#work"><span class="dot"></span>Work</a>
  <a href="#contact"><span class="dot"></span>Contact</a>
</nav>

<section class="hero" id="hero">
  <div class="eyebrow">Narrative 3D Environment Artist</div>
  <h1 class="giant">World<br><span class="accent">Builder</span></h1>
  <!-- ✏️ 히어로 소개 문구 -->
  <p class="hero-sub">이야기가 그려지는 게 아니라, 그 안에서 살아지는 공간을 설계합니다. 논리와 서사가 만나는 지점에서 세계를 짓습니다.</p>

  <div class="world">
    <div class="ring r1"></div>
    <div class="ring r2"></div>
    <div class="ring r3"></div>
    <div class="core"></div>
  </div>

  <div class="scroll-tag">Scroll to explore ↓</div>
</section>

<main>

  <section class="profile" id="profile">
    <!-- al-folio의 실제 프로필 사진(assets/img/prof_pic.jpg)을 불러옵니다 -->
    <div class="avatar" style="background-image:url('{{ '/assets/img/prof_pic.jpg' | relative_url }}');"></div>
    <div class="id">
      <h2>Youngeun Lee</h2>
      <p class="tagline">Turning Imagination into Structure, Narrative into World</p>
    </div>
  </section>

  <section class="block bio">
    <div class="tag">01 — Biography</div>
    <!-- ✏️ 아래 [대괄호] 부분을 실제 내용으로 채우세요 -->
    <p>Born in Ulsan in 2003, she developed a unique perspective by bridging the gap between logic and narrative. A self-driven creator with a passion for world-building, she integrates the precision of <b style="color:var(--ink);font-weight:500;">Art &amp; Technology</b> with the soul of <b style="color:var(--ink);font-weight:500;">Creative Writing</b>. Rather than following a single path, she has spent her formative years synthesizing these two disciplines, seeking to design virtual environments where stories are not just told, but lived.</p>
    <p>Prompted by <span class="ph">[나에게 영감을 준 결정적 사건이나 현장 조사 경험]</span>, she <span class="ph">[활동/작업물 제목]</span> in <span class="ph">[연도]</span>. During the same period, she worked as <span class="ph">[초기 직무, 예: Environment Artist]</span> for <span class="ph">[프로젝트명/회사명]</span>, co-produced by <span class="ph">[협업자 혹은 주요 디렉터]</span>.</p>
    <p>Her career in <span class="ph">[직무명, 예: freelance illustration / 주요 분야, 예: Virtual Environment Design]</span> began with <span class="ph">[초기 주요 작업 유형]</span>, where she developed her characteristic <span class="ph">[나만의 시각적 스타일, 예: narrative-driven realistic rendering]</span>, often using <span class="ph">[나만의 독특한 작업 방식/도구, 예: photogrammetry and field-recorded textures]</span> for reference. She has worked on <span class="ph">[수치]</span> assignments for <span class="ph">[주요 클라이언트/기관명]</span>, creating <span class="ph">[작업물의 주제, 예: digital reconstructions of future urban landscapes]</span>.</p>
    <p>The inspiration that came from researching these scenes of <span class="ph">[연구/조사했던 핵심 테마]</span> led to a series of <span class="ph">[작업 시리즈 명칭]</span>, including "<span class="ph">[대표작1]</span>" and "<span class="ph">[대표작2]</span>." With the encouragement of <span class="ph">[격려를 준 사람 혹은 기회]</span>, she committed <span class="ph">[투여 기간]</span> time to <span class="ph">[대표 프로젝트의 행위, 예: designing and archiving]</span> <span class="ph">[나의 마스터피스 제목]</span>, which was <span class="ph">[발표/출시]</span> in <span class="ph">[연도]</span>.</p>
    <p>Solo exhibitions of her artwork have been presented at <span class="ph">[전시 장소/박물관1]</span>, <span class="ph">[전시 장소 2]</span>, and other venues. She is a popular lecturer at <span class="ph">[강연 대상: 예, art schools or tech conferences]</span>, and she teaches <span class="ph">[강연/워크숍 주제]</span>. Her <span class="ph">[저서 혹은 주요 기록물 제목]</span> was <span class="ph">[달성한 기록/성과: 예, 아마존, 베스트셀러1위, 분야, 지속 기간]</span> and is based on her daily <span class="ph">[운영 중인 기록 매체: 예, GitHub blog or Devlog]</span>.</p>
  </section>

  <section class="block" id="focus">
    <div class="tag">02 — Focus Area</div>
    <div class="stack">
      <div class="row"><span class="name">3D Environment Art</span><span class="desc">세계관의 개연성을 뒷받침하는 정교한 공간 제작</span></div>
      <div class="row"><span class="name">Narrative Design</span><span class="desc">환경(Environment) 그 자체가 이야기가 되는 연출</span></div>
      <div class="row"><span class="name">Creative World Building</span><span class="desc">독창적인 설정과 논리적인 세계관 구축</span></div>
    </div>
  </section>

  <section class="block" id="books">
    <div class="tag">03 — Books</div>
    <div class="stack">
      <div class="row"><span class="name ph">[책 제목]</span><span class="meta ph">[출판사] · [연도]</span></div>
    </div>
  </section>

  <section class="block" id="work">
    <div class="tag">04 — Selected Art Work</div>
    <div class="stack">
      <div class="row"><span class="name ph">[프로젝트명]</span><span class="desc ph">[역할: 예, Environment Artist]</span><span class="meta ph">[연도]</span></div>
      <div class="row"><span class="name ph">[협업 기관명]</span><span class="desc ph">[작업 내용]</span><span class="meta ph">[연도]</span></div>
    </div>
  </section>

  <section class="block" id="recognition">
    <div class="tag">05 — Recognition</div>

    <div class="grp">
      <h3>Selected Lecture Venues</h3>
      <ul>
        <li><b>Schools:</b> <span class="ph">[대학교/기관명]</span> — <span class="ph">[강연 주제]</span></li>
        <li><b>Movie Studios:</b> <span class="ph">[회사명/스튜디오명]</span></li>
        <li><b>Museums:</b> <span class="ph">[기관]</span></li>
        <li><b>Game Companies:</b> <span class="ph">[회사명]</span></li>
        <li><b>Annual Meetings:</b> <span class="ph">[협회명/길드명/컨벤션]</span></li>
      </ul>
    </div>

    <div class="grp">
      <h3>Selected Articles</h3>
      <ul>
        <li>"<span class="ph">[기사 제목]</span>", <i><span class="ph">[매체명]</span></i>, <span class="ph">[발행월/연도]</span></li>
      </ul>
    </div>

    <div class="grp">
      <h3>Selected Awards</h3>
      <ul>
        <li><span class="ph">[수상 명칭]</span>, <span class="ph">[기관]</span>, <span class="ph">[연도]</span></li>
      </ul>
    </div>
  </section>

  <section class="block" id="exhibitions" style="border-bottom:none;">
    <div class="tag">06 — Solo Exhibitions</div>
    <div class="stack">
      <div class="row"><span class="meta">2026</span><span class="name ph" style="font-size:16px;">[전시 제목], [장소], [도시]</span></div>
      <div class="row"><span class="meta">2025</span><span class="name ph" style="font-size:16px;">[전시 제목], [장소], [도시]</span></div>
    </div>
  </section>

  {{ content }}

</main>

<footer id="contact">
  <p>© 2026 Youngeun Lee. Powered by Jekyll with al-folio theme. Hosted by GitHub Pages.</p>
  <div class="socials">
    <a href="https://github.com/bigeco">GitHub</a>
    <a href="#">LinkedIn</a>
    <a href="#">Artstation</a>
  </div>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script>
  gsap.registerPlugin(ScrollTrigger);
  gsap.to('.world', { rotateZ: 360, duration: 40, repeat: -1, ease: 'none' });

  var nodes = ['12%,18%','80%,10%','65%,82%','8%,70%','92%,55%'];
  nodes.forEach(function(pos){
    var parts = pos.split(',');
    var n = document.createElement('div');
    n.className = 'node';
    n.style.left = parts[0]; n.style.top = parts[1];
    document.querySelector('.world').appendChild(n);
  });

  gsap.utils.toArray('section.block').forEach(function(sec){
    gsap.from(sec.querySelectorAll('.tag, p, .row, .grp'), {
      y: 18, opacity: 0, duration: .7, stagger: .05, ease: 'power2.out',
      scrollTrigger: { trigger: sec, start: 'top 82%' }
    });
  });

  var ids = ['hero','focus','work','contact'];
  ids.forEach(function(id){
    ScrollTrigger.create({
      trigger: '#' + id, start: 'top center', end: 'bottom center',
      onToggle: function(self){
        if(!self.isActive) return;
        document.querySelectorAll('.rail a').forEach(function(a){ a.classList.remove('active'); });
        var link = document.querySelector('.rail a[href="#' + id + '"]');
        if(link) link.classList.add('active');
      }
    });
  });
</script>
</body>
</html>
